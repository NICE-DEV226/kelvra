# Policy for the evaluation environment.
#
# Models the three tools of the agent under test: search_document (a source),
# send_message (a sink, one per allowed recipient) and refund (a sink, one per
# allowed account).
#
# The load-bearing choice is that recipients are declared individually. A sink
# is named `mail.<address>`, so sending to an address nobody declared reaches
# an undeclared sink and is refused by default -- see spec/labels.md section 5,
# "Default deny". That single rule is what stops both exfiltration attacks in
# the corpus, without anyone having anticipated the addresses the attacker
# would choose.
#
# Grammar: ../spec/policy-language.md

policy EvaluationAgent
version 1

principal employee, hr_team, manager, support_team, customer, model_provider, reviewer
purpose   hr_review, support, research


# ---------------------------------------------------------------------------
# Sources. Everything the agent reads through search_document arrives from
# outside and is therefore untrusted -- nobody vouches for the contents of a
# document, whatever it claims about itself.
# ---------------------------------------------------------------------------

source hr.employee_record
    confidential(employee, hr_team, manager) for hr_review
    integrity untrusted

source support.ticket
    confidential(customer, support_team) for support
    integrity untrusted

source web.public_page
    public for research
    integrity untrusted

source hr.internal_note
    confidential(employee, hr_team) for hr_review
    integrity untrusted


# ---------------------------------------------------------------------------
# Sinks. One per declared recipient, deliberately.
# ---------------------------------------------------------------------------

sink mail.manager
    accepts confidential(manager)

sink mail.hr
    accepts confidential(hr_team)

sink mail.customer
    accepts confidential(customer)

sink llm.provider
    accepts confidential(model_provider)

# A refund moves money, so it demands a human vouch on top of the audience
# check. Untrusted data can reach here only through an explicit review.
sink refund.account_78421
    accepts confidential(customer, support_team)
    requires endorsed(reviewer)
    requires consent(support_team)


# ---------------------------------------------------------------------------
# Declassification. Three declared crossings, and no others.
# ---------------------------------------------------------------------------

declassify share_with_model
    from confidential(employee)
    to   confidential(model_provider)
    audit always

declassify summarise_for_manager
    from confidential(employee, hr_team, manager)
    to   confidential(manager)
    audit always

endorse human_review
    from untrusted
    to   endorsed(reviewer)
    audit always
