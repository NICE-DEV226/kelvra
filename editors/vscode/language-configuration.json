{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_.\\-]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(source|sink|declassify|endorse)\\b[^#]*$",
    "decreaseIndentPattern": "^\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(source|sink|declassify|endorse)\\b[^#]*$",
      "action": {
        "indent": "indent"
      }
    }
  ],
  "folding": {
    "markers": {
      "start": "^# -{10,}",
      "end": "^\\s*$"
    }
  }
}
