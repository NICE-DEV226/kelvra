{
  "name": "kelvra-klv",
  "displayName": "Kelvra policy (.klv)",
  "description": "Syntax highlighting, snippets and editing rules for Kelvra policy files (.klv). Highlighting only: nothing here validates a policy. Run `kelvra check`, or connect `kelvra lsp` as a language server, for that.",
  "version": "0.1.0",
  "publisher": "kelvra",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NICE-DEV226/kelvra.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "klv",
        "aliases": [
          "Kelvra policy",
          "klv",
          "kelvra"
        ],
        "extensions": [
          ".klv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "klv",
        "scopeName": "source.klv",
        "path": "./syntaxes/klv.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "klv",
        "path": "./snippets/klv.code-snippets"
      }
    ]
  },
  "keywords": [
    "kelvra",
    "klv",
    "policy",
    "information-flow",
    "ai-agents",
    "security"
  ]
}
